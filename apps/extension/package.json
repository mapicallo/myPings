{
  "name": "@my-pings/extension",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build-extension.mjs",
    "build:pwa": "node scripts/build-pwa.mjs",
    "icons": "node scripts/write-placeholder-icons.mjs",
    "pack": "npm run build && node scripts/package-zip.mjs",
    "pack:all": "npm run pack && npm run build:pwa"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "archiver": "^7.0.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.2"
  }
}
