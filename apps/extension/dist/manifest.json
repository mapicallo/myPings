{
  "manifest_version": 3,
  "name": "My Pings",
  "version": "0.2.0",
  "description": "My Pings — all your chosen alerts in one list. RSS feeds you follow. On demand.",
  "action": {
    "default_title": "My Pings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
